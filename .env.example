# Absolute origin for canonicals, OpenGraph and JSON-LD. Set this per deploy —
# without it a preview build points every canonical at production.
NEXT_PUBLIC_SITE_URL=https://xevantis.com

# --- /get-started lead delivery -------------------------------------------
# Server-only. Without RESEND_API_KEY the form refuses the submit and tells the
# visitor to email sales directly, rather than reporting a send that never
# happened. Create the key at https://resend.com/api-keys.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Where leads land. Defaults to Sales@xevantis.com.
LEAD_TO_EMAIL=Sales@xevantis.com

# Sender. The domain must be verified in Resend (Domains → Add Domain, then the
# DKIM/SPF records) or the API rejects every send. Defaults to
# "Xevantis Website <leads@xevantis.com>".
LEAD_FROM_EMAIL=Xevantis Website <leads@xevantis.com>
